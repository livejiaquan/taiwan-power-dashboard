{
  "name": "taiwan-power-dashboard",
  "version": "0.2.0",
  "description": "Taiwan real-time power dashboard using Taipower open data.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build:web": "vite build",
    "build:site": "node scripts/build-static-site.js",
    "build": "vite build && node scripts/build-static-site.js",
    "build:static-data": "node scripts/build-static-data.js",
    "preview": "vite preview --outDir dist",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "taiwan",
    "taipower",
    "open-data",
    "dashboard"
  ],
  "author": "Jiaquan",
  "engines": {
    "node": ">=22 <27"
  },
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
