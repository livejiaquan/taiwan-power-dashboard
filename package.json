{
  "name": "taiwan-power-dashboard",
  "version": "0.2.0",
  "description": "台灣電力即時看板：以台電官方開放資料呈現供電燈號、備轉容量率與發電結構。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build:web": "vite build",
    "build:site": "node scripts/build-static-site.js",
    "build": "vite build && node scripts/build-static-site.js",
    "build:static-data": "node scripts/build-static-data.js",
    "preview": "vite preview --outDir dist",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "test:e2e": "vite build && playwright test",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "keywords": [
    "taiwan",
    "taipower",
    "open-data",
    "dashboard"
  ],
  "author": "Lim Jia Quan",
  "homepage": "https://livejiaquan.github.io/taiwan-power-dashboard/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livejiaquan/taiwan-power-dashboard.git"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
